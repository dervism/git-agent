// A code window from the Tailwind Plus sections: a dark window with a tab bar.
// With `interactive`, the tabs are buttons in a tab list (each carries
// `data-window-tab` with its index, for the script that switches them);
// otherwise they are labels, the first one current. Other attributes, such as
// data-* hooks for scripts, go on the window.

interface Props {
  readonly tabs: readonly string[]
  readonly interactive?: boolean
  /** The tab list's accessible name, when `interactive`. */
  readonly label?: string
  /** Set the tab labels in the mono font, as for commands. */
  readonly mono?: boolean
  readonly class?: string
  readonly [attribute: `data-${string}`]: string | undefined
}

const { tabs, interactive = false, label, mono = true, class: className, ...attributes } = Astro.props
const tab = [
  'border-r border-gray-600/10 px-4 py-2 transition-colors duration-300',
  'aria-selected:border-b aria-selected:border-r-white/10 aria-selected:border-b-white/20 aria-selected:bg-white/5 aria-selected:text-white',
  'data-current:border-b data-current:border-r-white/10 data-current:border-b-white/20 data-current:bg-white/5 data-current:text-white',
  mono && 'font-mono',
]
---

<div {...attributes} class:list={['overflow-hidden rounded-tl-xl bg-gray-900', className]}>
  <div class="flex bg-gray-800/40 ring-1 ring-white/5">
    {
      interactive ? (
        <div role="tablist" aria-label={label} class="-mb-px flex text-sm/6 font-medium text-gray-400">
          {tabs.map((name, index) => (
            <button
              type="button"
              role="tab"
              data-window-tab={index}
              aria-selected={index === 0 ? 'true' : 'false'}
              class:list={[tab, 'hover:text-gray-200']}
            >
              {name}
            </button>
          ))}
        </div>
      ) : (
        <div class="-mb-px flex text-sm/6 font-medium text-gray-400">
          {tabs.map((name, index) => (
            <div data-current={index === 0 ? '' : undefined} class:list={tab}>
              {name}
            </div>
          ))}
        </div>
      )
    }
  </div>
  <slot />
</div>
