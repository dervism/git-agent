import Layout from '../layouts/Layout.astro'
import Header from '../blocks/Header.astro'
import Hero from '../blocks/Hero.astro'
import Providers from '../components/Providers.astro'
import Features from '../blocks/Features.astro'
import Explain from '../blocks/Explain.astro'
import Safety from '../blocks/Safety.astro'
import Install from '../components/Install.astro'
import Cta from '../blocks/Cta.astro'
import Footer from '../blocks/Footer.astro'
import Divider from '../design/components/Divider.astro'
import {
  crate,
  explainFeatures,
  explainSamples,
  installMethods,
  navigation,
  news,
  providers,
  quickStart,
  repository,
  safetyFeatures,
  scenes,
  untracked,
  version,
} from '../content/site'
---

<Layout
  title="git-agent · Let a language model do your git chores"
  description="git-agent writes commit messages, names branches, splits and tidies commits, and opens pull requests, with a local or cloud language model. You review every proposal."
>
  <Header navigation={navigation} repository={repository} />
  <main>
    <Hero news={news} repository={repository} scenes={scenes} />
    <Providers providers={providers} />
    <Divider />
    <Features />
    <Divider />
    <Explain features={explainFeatures} samples={explainSamples} />
    <Divider />
    <Safety features={safetyFeatures} featured={untracked} />
    <Divider />
    <Install methods={installMethods} steps={quickStart} />
    <Cta />
  </main>
  <Footer repository={repository} crate={crate} version={version} />
</Layout>
