// Install methods as tabs with copy buttons, then the first three steps.
import Chip from '../design/components/Chip.astro'
import Icon from '../design/components/Icon.astro'
import Section from '../design/components/Section.astro'
import SectionHeading from '../blocks/SectionHeading.astro'
import type { InstallMethod, Step } from '../content/site'

interface Props {
  readonly methods: readonly InstallMethod[]
  readonly steps: readonly Step[]
}

const { methods, steps } = Astro.props
---

<Section id="install" labelledby="install-heading">
  <div slot="background" aria-hidden="true" class="grid-lines absolute inset-0 -z-10 opacity-60"></div>
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <SectionHeading eyebrow="Install" id="install-heading" align="center">
      Running in a minute
      <Fragment slot="lead">
        git-agent is a single binary. Install it with Homebrew or Cargo, and git runs it as
        <Chip class="text-base text-white">git agent</Chip>.
      </Fragment>
    </SectionHeading>

    <div data-reveal style="--reveal-delay: 240ms" data-install class="mx-auto mt-14 max-w-3xl">
      <div class="panel relative overflow-hidden rounded-3xl p-2 backdrop-blur-sm">
        <div role="tablist" aria-label="Ways to install" class="relative flex gap-1 rounded-2xl bg-gray-950/50 p-1">
          <span
            aria-hidden="true"
            data-indicator
            class="absolute inset-y-1 left-1 rounded-xl bg-white/10 ring-1 ring-white/10 transition-[transform,width] duration-500 ease-[cubic-bezier(0.16,1,0.3,1)]"
          ></span>
          {
            methods.map((method, index) => (
              <button
                type="button"
                role="tab"
                id={`install-tab-${index}`}
                aria-controls={`install-${index}`}
                aria-selected={index === 0 ? 'true' : 'false'}
                data-install-tab={index}
                class="relative flex-1 rounded-xl px-2 py-2.5 text-sm font-semibold whitespace-nowrap text-gray-400 transition-colors duration-300 hover:text-gray-200 aria-selected:text-white sm:px-4"
              >
                {method.name}
              </button>
            ))
          }
        </div>
        {
          methods.map((method, index) => (
            <div
              role="tabpanel"
              id={`install-${index}`}
              aria-labelledby={`install-tab-${index}`}
              data-install-panel={index}
              hidden={index !== 0}
              class="px-6 pt-6 pb-5"
            >
              <div class="flex items-start justify-between gap-x-4">
                <div class="overflow-x-auto font-mono text-[12.5px]/7 whitespace-nowrap text-gray-200 sm:text-sm/7">
                  {method.commands.map((command) => (
                    <div>
                      <span class="text-brand-400 select-none">$&nbsp;</span>
                      {command}
                    </div>
                  ))}
                </div>
                <button
                  type="button"
                  data-copy={method.commands.join('\n')}
                  class="group/copy relative shrink-0 rounded-lg p-2 text-gray-400 ring-1 ring-white/10 transition hover:bg-white/5 hover:text-white"
                >
                  <span class="sr-only">Copy the command</span>
                  <Icon
                    name="ClipboardDocument"
                    class="size-5 transition-all duration-300 group-data-copied/copy:scale-50 group-data-copied/copy:opacity-0"
                  />
                  <Icon
                    name="Check"
                    class="absolute inset-2 size-5 scale-50 text-brand-300 opacity-0 transition-all duration-300 group-data-copied/copy:scale-100 group-data-copied/copy:opacity-100"
                  />
                </button>
              </div>
              <p class="mt-4 text-sm/6 text-gray-500">{method.note}</p>
            </div>
          ))
        }
      </div>
    </div>

    <ol class="mx-auto mt-20 grid max-w-5xl grid-cols-1 gap-8 sm:grid-cols-3">
      {
        steps.map((step, index) => (
          <li data-reveal style={`--reveal-delay: ${index * 120}ms`} class="relative">
            <div class="flex items-center gap-x-4">
              <span class="flex size-9 items-center justify-center rounded-full bg-white/5 font-mono text-sm font-semibold text-white ring-1 ring-white/15">
                {index + 1}
              </span>
              {index < steps.length - 1 && (
                <span aria-hidden="true" class="h-px flex-1 bg-linear-to-r from-white/15 to-transparent max-sm:hidden" />
              )}
            </div>
            <h3 class="mt-5 text-base/7 font-semibold text-white">{step.name}</h3>
            <p class="mt-1 text-sm/6 text-gray-400">{step.description}</p>
            {step.command && <Chip class="mt-3">{step.command}</Chip>}
          </li>
        ))
      }
    </ol>
  </div>
</Section>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-install]')) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-install-tab]')]
    const panels = [...root.querySelectorAll<HTMLElement>('[data-install-panel]')]
    const indicator = root.querySelector<HTMLElement>('[data-indicator]')!

    const moveIndicator = (tab: HTMLElement) => {
      indicator.style.width = `${tab.offsetWidth}px`
      indicator.style.transform = `translateX(${tab.offsetLeft - 4}px)`
    }
    const select = (index: number) => {
      tabs.forEach((tab, at) => tab.setAttribute('aria-selected', String(at === index)))
      panels.forEach((panel, at) => (panel.hidden = at !== index))
      moveIndicator(tabs[index])
    }
    tabs.forEach((tab, index) => tab.addEventListener('click', () => select(index)))
    // Arrow keys move between tabs, as for any tab list.
    root.addEventListener('keydown', (event) => {
      const at = tabs.indexOf(document.activeElement as HTMLButtonElement)
      if (at < 0 || !['ArrowLeft', 'ArrowRight'].includes(event.key)) return
      const next = (at + (event.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length
      tabs[next].focus()
      select(next)
    })
    moveIndicator(tabs[0])
    new ResizeObserver(() => moveIndicator(tabs.find((tab) => tab.ariaSelected === 'true') ?? tabs[0])).observe(root)
  }

  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
    button.addEventListener('click', async () => {
      await navigator.clipboard.writeText(button.dataset.copy ?? '')
      button.toggleAttribute('data-copied', true)
      setTimeout(() => button.toggleAttribute('data-copied', false), 1600)
    })
  }
</script>
