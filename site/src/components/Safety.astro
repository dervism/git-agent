---
// Adapted from Tailwind Plus marketing-v4/sections/feature-sections/20.simple-3x2-grid.
import Icon from './Icon.astro'
import type { Feature } from '../content/site'

interface Props {
  readonly features: readonly Feature[]
}

const { features } = Astro.props
---

<section id="safety" aria-labelledby="safety-heading" class="bg-white py-24 sm:py-32 dark:bg-gray-900">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mx-auto max-w-2xl lg:mx-0">
      <h2 id="safety-heading" data-reveal class="text-base/7 font-semibold text-brand-600 dark:text-brand-300">
        Safe by default
      </h2>
      <p
        data-reveal
        style="--reveal-delay: 80ms"
        class="mt-2 text-4xl font-semibold tracking-tight text-pretty text-gray-900 sm:text-5xl dark:text-white"
      >
        Careful with your code, keys and history
      </p>
      <p data-reveal style="--reveal-delay: 160ms" class="mt-6 text-lg/8 text-gray-700 dark:text-gray-300">
        git-agent works through plain git commands and asks before anything leaves your machine or rewrites what you
        have.
      </p>
    </div>
    <dl
      class="mx-auto mt-16 grid max-w-2xl grid-cols-1 gap-8 text-base/7 text-gray-600 sm:grid-cols-2 lg:mx-0 lg:max-w-none lg:grid-cols-3 lg:gap-x-16 dark:text-gray-400"
    >
      {
        features.map((feature, index) => (
          <div data-reveal style={`--reveal-delay: ${(index % 3) * 100}ms`} class="group relative pl-9">
            <dt class="inline font-semibold text-gray-900 dark:text-white">
              <Icon
                name={feature.icon}
                class="absolute top-1 left-1 size-5 text-brand-600 transition-transform duration-500 group-hover:scale-125 dark:text-brand-400"
              />
              {feature.name}
            </dt>{' '}
            <dd class="inline">{feature.description}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
