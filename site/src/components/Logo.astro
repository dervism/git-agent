---
interface Props {
  readonly class?: string
}

const { class: className } = Astro.props
// Each copy needs its own gradient ids: a gradient defined inside a hidden
// element (the closed mobile menu) doesn't paint for the other copies.
const id = Math.random().toString(36).slice(2, 8)
---

<svg viewBox="0 0 32 32" fill="none" aria-hidden="true" class={className}>
  <defs>
    <linearGradient id={`bg-${id}`} x1="0" y1="0" x2="32" y2="32" gradientUnits="userSpaceOnUse">
      <stop stop-color="#4A5C6A"></stop>
      <stop offset="1" stop-color="#11212D"></stop>
    </linearGradient>
    <linearGradient id={`line-${id}`} x1="10" y1="6" x2="22" y2="26" gradientUnits="userSpaceOnUse">
      <stop stop-color="#FFFFFF"></stop>
      <stop offset="1" stop-color="#9BA8AB"></stop>
    </linearGradient>
  </defs>
  <rect width="32" height="32" rx="9" fill={`url(#bg-${id})`}></rect>
  <rect x=".5" y=".5" width="31" height="31" rx="8.5" stroke="#FFFFFF" stroke-opacity=".16"></rect>
  <path
    d="M11.5 9.5v13M20.5 11.5c0 5.5-9 3.5-9 9"
    stroke={`url(#line-${id})`}
    stroke-width="2.2"
    stroke-linecap="round"></path>
  <circle cx="11.5" cy="8.5" r="2.6" fill="#CCD0CF"></circle>
  <circle cx="11.5" cy="23.5" r="2.6" fill="#CCD0CF"></circle>
  <circle cx="20.5" cy="10" r="2.9" fill="#FFFFFF"></circle>
</svg>
