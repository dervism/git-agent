// The hero's code window, playing git-agent sessions: one tab per session.
import CodeWindow from '../blocks/CodeWindow.astro'
import { tone } from '../design/terminal'
import type { Scene } from '../content/site'

interface Props {
  readonly scenes: readonly Scene[]
  readonly class?: string
}

const { scenes, class: className } = Astro.props
const first = scenes[0]
---

<CodeWindow
  tabs={scenes.map((scene) => scene.tab)}
  interactive
  label="Example sessions"
  class={className}
  data-terminal=""
  data-scenes={JSON.stringify(scenes)}
>
  <div class="px-6 pt-6 pb-14">
    <div
      data-screen
      aria-live="polite"
      class="h-[23rem] overflow-hidden font-mono text-[12.5px]/6 whitespace-pre text-gray-300 sm:h-[26rem]"
    >
      {/* Without JavaScript, the first session is shown complete. */}
      <div><span class="text-brand-400">❯</span> <span class="text-white">{first.command}</span></div>
      {[...(first.before ?? []), ...(first.afterAnswer ?? []), ...first.output].map((line) => (
        <div class={tone(line)}>{line.text || ' '}</div>
      ))}
    </div>
  </div>
</CodeWindow>

<script>
  import { tones, type Tone } from '../design/terminal'
  import type { Scene } from '../content/site'

  const spinner = ['⠋', '⠙', '⠹', '⠸', '⠼', '⠴', '⠦', '⠧', '⠇', '⠏']
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches

  for (const root of document.querySelectorAll<HTMLElement>('[data-terminal]')) {
    const scenes: Scene[] = JSON.parse(root.dataset.scenes ?? '[]')
    const screen = root.querySelector<HTMLElement>('[data-screen]')!
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-window-tab]')]
    let run = 0
    let current = 0
    let visible = false

    const sleep = (ms: number, token: number) =>
      new Promise<void>((resolve, reject) =>
        setTimeout(() => (token === run ? resolve() : reject(new Error('cancelled'))), ms),
      )

    const line = (text: string, tone: Tone = 'plain') => {
      const element = document.createElement('div')
      element.className = `${tones[tone]} transition-opacity duration-300`
      element.textContent = text || ' '
      screen.append(element)
      return element
    }

    const prompt = () => {
      const element = document.createElement('div')
      element.innerHTML =
        '<span class="text-brand-400">❯</span> <span class="text-white" data-typed></span><span class="ml-px inline-block h-4 w-2 translate-y-0.5 animate-blink bg-gray-300" data-caret></span>'
      screen.append(element)
      return element
    }

    const select = (index: number) =>
      tabs.forEach((tab, at) => tab.setAttribute('aria-selected', String(at === index)))

    const showStatic = (scene: Scene) => {
      screen.replaceChildren()
      const head = prompt()
      head.querySelector('[data-typed]')!.textContent = scene.command
      head.querySelector('[data-caret]')!.remove()
      ;(scene.before ?? []).forEach((entry) => line(entry.text, entry.tone))
      if (scene.beforeAnswer) screen.lastElementChild!.append(` ${scene.beforeAnswer}`)
      ;(scene.afterAnswer ?? []).forEach((entry) => line(entry.text, entry.tone))
      scene.output.forEach((entry) => line(entry.text, entry.tone))
      if (scene.answer) screen.lastElementChild!.append(` ${scene.answer}`)
      scene.after.forEach((entry) => line(entry.text, entry.tone))
    }

    const play = async (scene: Scene, token: number) => {
      screen.replaceChildren()
      const head = prompt()
      const typed = head.querySelector('[data-typed]')!
      await sleep(500, token)
      for (const char of scene.command) {
        typed.textContent += char
        await sleep(38 + Math.random() * 55, token)
      }
      await sleep(420, token)
      head.querySelector('[data-caret]')!.remove()

      // A scene that asks before it calls the model shows its question first.
      const before = scene.before ?? []
      for (const entry of before) {
        line(entry.text, entry.tone)
        await sleep(entry.text ? 70 : 30, token)
      }
      if (scene.beforeAnswer) {
        await sleep(1100, token)
        screen.lastElementChild!.append(` ${scene.beforeAnswer}`)
        await sleep(400, token)
        for (const entry of scene.afterAnswer ?? []) {
          line(entry.text, entry.tone)
          await sleep(160, token)
        }
      }

      const thinking = line('', 'muted')
      const started = performance.now()
      for (let frame = 0; frame < 16; frame++) {
        const seconds = Math.floor((performance.now() - started) / 1000)
        thinking.textContent = `${spinner[frame % spinner.length]} Generating with google/gemma-4-e4b ${seconds}s`
        await sleep(90, token)
      }
      thinking.remove()

      for (const entry of scene.output) {
        const element = line(entry.text, entry.tone)
        element.style.opacity = '0'
        requestAnimationFrame(() => (element.style.opacity = '1'))
        await sleep(entry.text ? 70 : 30, token)
      }
      if (scene.answer) {
        await sleep(900, token)
        screen.lastElementChild!.append(` ${scene.answer}`)
        await sleep(450, token)
      }
      for (const entry of scene.after) {
        line(entry.text, entry.tone)
        await sleep(160, token)
      }
      await sleep(3600, token)
    }

    const loop = async (start: number) => {
      const token = ++run
      current = start
      try {
        while (token === run) {
          select(current)
          await play(scenes[current], token)
          current = (current + 1) % scenes.length
        }
      } catch {
        // A newer run took over.
      }
    }

    tabs.forEach((tab, index) =>
      tab.addEventListener('click', () => {
        if (reducedMotion) {
          select(index)
          showStatic(scenes[index])
        } else {
          loop(index)
        }
      }),
    )

    if (reducedMotion) {
      showStatic(scenes[0])
      continue
    }
    // Play only while the terminal is on screen, picking up where it left off.
    new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting && !visible) {
        visible = true
        loop(current)
      } else if (!entry.isIntersecting && visible) {
        visible = false
        run++
      }
    }).observe(root)
  }
</script>
