import '../design/index.css'

interface Props {
  readonly title: string
  readonly description: string
}

const { title, description } = Astro.props
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/')
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#06141B" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <script is:inline>
      document.documentElement.classList.add('js')
    </script>
  </head>
  <body class="bg-white text-gray-600 dark:bg-gray-900 dark:text-gray-300">
    <slot />
    <div
      aria-hidden="true"
      class="grain pointer-events-none fixed inset-0 z-[70] opacity-[0.035] mix-blend-overlay"
    >
    </div>
    <script>
      import { startMotion } from '../design/motion'

      startMotion()
    </script>
  </body>
</html>
