# Build output
/target
**/*.rs.bk
*.pdb

# Temporary files (older git-agent versions wrote .git_commit_msg.tmp)
*.tmp
*.orig

# Scratch space for agents and tests; only the folder itself is tracked
/tmp/*
!/tmp/.gitkeep

# Private planning documents: kept on this machine, never pushed
/docs/planning/
/docs/iterations/
/docs/architecture/design/

# Local environment and secrets
.env
.env.*

# Editors and IDEs
.idea/
.vscode/
*.iml
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
