---
// Adapted from Tailwind Plus marketing-v4/sections/heroes/04-split-with-code-example.
// The logo moved to the header; the code window plays git-agent sessions.
import Icon from './Icon.astro'
import Terminal from './Terminal.astro'
import type { Scene } from '../content/site'

interface Props {
  readonly version: string
  readonly repository: string
  readonly scenes: readonly Scene[]
}

const { version, repository, scenes } = Astro.props
const minor = version.split('.').slice(0, 2).join('.')
---

<div id="top" class="bg-white dark:bg-gray-900">
  <div class="relative isolate overflow-hidden bg-linear-to-b from-brand-100/20 dark:from-brand-950/40">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-20">
      <div class="grid-lines absolute inset-0"></div>
      <div
        class="absolute -top-40 left-[-10%] size-[42rem] animate-drift rounded-full bg-brand-700/25 blur-[120px]"
      >
      </div>
      <div
        class="absolute top-1/3 right-[-15%] size-[36rem] animate-drift-slow rounded-full bg-gray-600/30 blur-[120px]"
      >
      </div>
    </div>
    <div class="mx-auto max-w-7xl pt-36 pb-24 sm:pt-40 sm:pb-32 lg:grid lg:grid-cols-2 lg:gap-x-8 lg:px-8 lg:py-48">
      <div class="px-6 lg:px-0 lg:pt-4">
        <div class="mx-auto max-w-2xl">
          <div class="max-w-lg">
            <div data-reveal>
              <a href="#features" class="inline-flex space-x-6">
                <span
                  class="rounded-full bg-brand-50 px-3 py-1 text-sm/6 font-semibold whitespace-nowrap text-brand-600 ring-1 ring-brand-600/20 ring-inset dark:bg-brand-500/10 dark:text-brand-300 dark:ring-brand-400/25"
                >
                  New in {minor}
                </span>
                <span class="inline-flex items-center space-x-2 text-sm/6 font-medium text-gray-600 dark:text-gray-300">
                  <span>Name branches and tidy commits</span>
                  <Icon name="ChevronRight" class="size-5 text-gray-400 dark:text-gray-500" />
                </span>
              </a>
            </div>
            <h1
              data-reveal
              style="--reveal-delay: 80ms"
              class="mt-10 text-5xl font-semibold tracking-tight text-pretty text-gray-900 sm:text-7xl dark:text-white"
            >
              Let a language model do your <span class="text-sheen animate-shimmer">git chores</span>
            </h1>
            <p
              data-reveal
              style="--reveal-delay: 160ms"
              class="mt-8 text-lg font-medium text-pretty text-gray-500 sm:text-xl/8 dark:text-gray-400"
            >
              git-agent writes commit messages, names branches, splits and tidies commits, and opens pull requests.
              It runs with a model on your own machine or in the cloud, and you review every proposal before it
              lands.
            </p>
            <div data-reveal style="--reveal-delay: 240ms" class="mt-10 flex items-center gap-x-6">
              <a
                href="#install"
                class="rounded-md bg-brand-600 px-3.5 py-2.5 text-sm font-semibold text-white shadow-xs transition hover:bg-brand-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600 dark:bg-gray-200 dark:text-gray-900 dark:shadow-[0_0_40px_-8px_var(--color-brand-300)] dark:hover:bg-white dark:focus-visible:outline-gray-200"
              >
                Install git-agent
              </a>
              <a href={repository} class="group text-sm/6 font-semibold text-gray-900 dark:text-white">
                View on GitHub <span aria-hidden="true" class="inline-block transition-transform group-hover:translate-x-1"
                  >→</span
                >
              </a>
            </div>
          </div>
        </div>
      </div>
      <div
        data-reveal
        style="--reveal-delay: 320ms"
        class="mt-20 sm:mt-24 md:mx-auto md:max-w-2xl lg:mx-0 lg:mt-0 lg:w-screen"
      >
        <div
          aria-hidden="true"
          class="absolute inset-y-0 right-1/2 -z-10 -mr-10 w-[200%] skew-x-[-30deg] bg-white shadow-xl ring-1 shadow-brand-600/10 ring-brand-50 md:-mr-20 lg:-mr-36 dark:bg-gray-800/30 dark:shadow-brand-400/10 dark:ring-white/5"
        >
        </div>
        <div class="shadow-lg md:rounded-3xl dark:shadow-[0_40px_120px_-30px_rgb(0_0_0/0.8)]">
          <div
            class="bg-brand-500 [clip-path:inset(0)] md:[clip-path:inset(0_round_var(--radius-3xl))] dark:bg-linear-to-br dark:from-gray-600 dark:via-gray-700 dark:to-gray-800"
          >
            <div
              aria-hidden="true"
              class="absolute -inset-y-px left-1/2 -z-10 ml-10 w-[200%] skew-x-[-30deg] bg-brand-100 opacity-20 inset-ring inset-ring-white md:ml-20 lg:ml-36"
            >
            </div>
            <div class="relative px-6 pt-8 sm:pt-16 md:pr-0 md:pl-16">
              <div class="mx-auto max-w-2xl md:mx-0 md:max-w-none">
                <div class="w-screen overflow-hidden rounded-tl-xl bg-gray-900">
                  <Terminal scenes={scenes} />
                </div>
              </div>
              <div
                aria-hidden="true"
                class="pointer-events-none absolute inset-0 ring-1 ring-black/10 ring-inset md:rounded-3xl dark:ring-white/10"
              >
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="absolute inset-x-0 bottom-0 -z-10 h-24 bg-linear-to-t from-white sm:h-32 dark:from-gray-900"></div>
  </div>
</div>
