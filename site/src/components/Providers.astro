// The servers and providers git-agent works with, as a slow marquee.
import Section from '../design/components/Section.astro'

interface Props {
  readonly providers: readonly string[]
}

const { providers } = Astro.props
---

<Section labelledby="providers-heading" rhythm="tight">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <h2
      id="providers-heading"
      data-reveal
      class="text-center text-sm/6 font-semibold tracking-wide text-gray-900 uppercase dark:text-gray-400"
    >
      Works with the model you already run
    </h2>
    <div
      data-reveal
      style="--reveal-delay: 120ms"
      class="group relative mt-10 overflow-hidden mask-x-from-80% mask-x-to-100%"
    >
      <div class="flex w-max animate-marquee group-hover:[animation-play-state:paused]">
        {
          [false, true].map((copy) => (
            <ul aria-hidden={copy ? 'true' : undefined} class="flex shrink-0 items-center gap-x-14 pr-14">
              {providers.map((provider) => (
                <li class="flex items-center gap-x-14 text-2xl font-semibold tracking-tight whitespace-nowrap text-gray-500 transition-colors duration-300 hover:text-gray-100 sm:text-3xl">
                  {provider}
                  <span aria-hidden="true" class="size-1.5 rounded-full bg-gray-700" />
                </li>
              ))}
            </ul>
          ))
        }
      </div>
    </div>
  </div>
</Section>
