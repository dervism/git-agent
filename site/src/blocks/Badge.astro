// A small pill in the accent color: "New in 0.8", a version.

interface Props {
  readonly mono?: boolean
  readonly class?: string
}

const { mono = false, class: className } = Astro.props
---

<span
  class:list={[
    'rounded-full bg-brand-50 px-3 py-1 text-sm/6 font-semibold whitespace-nowrap text-brand-600 ring-1 ring-brand-600/20 ring-inset dark:bg-brand-500/10 dark:text-brand-300 dark:ring-brand-400/25',
    mono && 'font-mono',
    className,
  ]}
>
  <slot />
</span>
